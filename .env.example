# Скопируйте в .env (локально) или задайте в Vercel → Settings → Environment Variables.
# Значения НЕ коммитить. Файл .env — в .gitignore.

# Postgres (Neon, отдельный проект от knyaz-barbershop). Pooled connection string.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Одноразовый токен первой настройки /admin/setup. Длинная случайная строка.
# После создания владельца эндпоинт /api/setup мёртв. Для сброса пароля
# задайте новый токен и удалите владельца через SQL (см. README.md).
SETUP_TOKEN=

# Порт локального dev-сервера (по умолчанию 3000).
PORT=3000

# Секрета подписи сессий нет и не нужно: сессии — случайные непрозрачные
# токены (256 бит), в БД хранится только их sha256-хеш. Ничего подписывать
# не требуется, поэтому SESSION_SECRET в проекте не используется.
